{
  "version": 1,
  "dialect": "Gulf / Emirati",
  "spelling": [
    ["3", "ع", "a squeeze deep in the throat", "3afwan"],
    ["7", "ح", "a breathy, whispered h", "mar7aba"],
    ["kh", "خ", "like Scottish 'loch'", "khalaas"],
    ["gh", "غ", "a soft gargled r", "ghaali"],
    ["g", "ق", "Gulf speakers say q as a hard g", "gahwa"],
    ["ch", "ك / چ", "some Emirati words turn k into ch", "chaay"],
    ["'", "ء", "a tiny catch in the throat", "masaa'"],
    ["aa ee oo", "", "long vowels: hold them a little longer", "zain, mashkoor"]
  ],
  "modules": [
    {
      "id": "m1",
      "title": "Greetings and courtesy",
      "blurb": "Say hello, ask how someone is, thank people and get by when you don't understand.",
      "items": [
        {"id": "m1-01", "en": "Peace be upon you (hello)", "tr": "as-salaamu 3alaikum", "ar": "السلام عليكم"},
        {"id": "m1-02", "en": "And upon you peace (reply)", "tr": "wa 3alaikum as-salaam", "ar": "وعليكم السلام"},
        {"id": "m1-03", "en": "Hello", "tr": "mar7aba", "ar": "مرحبا"},
        {"id": "m1-04", "en": "Hi (casual)", "tr": "hala", "ar": "هلا"},
        {"id": "m1-05", "en": "Hi there! (warm reply)", "tr": "hala wallah", "ar": "هلا والله"},
        {"id": "m1-06", "en": "Welcome (to a man)", "tr": "7ayyaak allah", "ar": "حياك الله", "note": "Very Emirati. To a woman: 7ayyaach allah."},
        {"id": "m1-07", "en": "God greet you too (reply to welcome)", "tr": "allah y7ayyeek", "ar": "الله يحييك"},
        {"id": "m1-08", "en": "Welcome", "tr": "ahlan wa sahlan", "ar": "أهلا وسهلا"},
        {"id": "m1-09", "en": "Good morning", "tr": "sabaa7 al-khair", "ar": "صباح الخير"},
        {"id": "m1-10", "en": "Good morning (reply)", "tr": "sabaa7 an-noor", "ar": "صباح النور"},
        {"id": "m1-11", "en": "Good evening", "tr": "masaa' al-khair", "ar": "مساء الخير"},
        {"id": "m1-12", "en": "Good evening (reply)", "tr": "masaa' an-noor", "ar": "مساء النور"},
        {"id": "m1-13", "en": "How are you? (to a man)", "tr": "shlonak?", "ar": "شلونك؟"},
        {"id": "m1-14", "en": "How are you? (to a woman)", "tr": "shlonich?", "ar": "شلونچ؟"},
        {"id": "m1-15", "en": "What's your news? (how are things)", "tr": "shakhbaarak?", "ar": "شخبارك؟"},
        {"id": "m1-16", "en": "How are you? (general)", "tr": "kaif 7aalak?", "ar": "كيف حالك؟"},
        {"id": "m1-17", "en": "I'm fine, thank God", "tr": "ana bkhair, al7amdillah", "ar": "أنا بخير، الحمد لله"},
        {"id": "m1-18", "en": "Good, thank God", "tr": "zain, al7amdillah", "ar": "زين، الحمد لله"},
        {"id": "m1-19", "en": "And you? (to a man)", "tr": "w inta?", "ar": "وإنت؟"},
        {"id": "m1-20", "en": "And you? (to a woman)", "tr": "w inti?", "ar": "وإنتي؟"},
        {"id": "m1-21", "en": "What's up?", "tr": "shu fi?", "ar": "شو في؟"},
        {"id": "m1-22", "en": "Nothing much", "tr": "ma fi shay", "ar": "ما في شي"},
        {"id": "m1-23", "en": "Thank you", "tr": "shukran", "ar": "شكرا"},
        {"id": "m1-24", "en": "Thanks (to a man)", "tr": "mashkoor", "ar": "مشكور"},
        {"id": "m1-25", "en": "You're welcome", "tr": "3afwan", "ar": "عفوا"},
        {"id": "m1-26", "en": "My pleasure (lit. on my head)", "tr": "3ala raasi", "ar": "على راسي"},
        {"id": "m1-27", "en": "Excuse me / please (to a man)", "tr": "law sama7t", "ar": "لو سمحت"},
        {"id": "m1-28", "en": "Please, go ahead / here you are (to a man)", "tr": "tfaddal", "ar": "تفضل"},
        {"id": "m1-29", "en": "Goodbye", "tr": "ma3a as-salaama", "ar": "مع السلامة"},
        {"id": "m1-30", "en": "Goodbye (go in God's protection)", "tr": "fi amaan illah", "ar": "في أمان الله"},
        {"id": "m1-31", "en": "God willing", "tr": "inshallah", "ar": "إن شاء الله"},
        {"id": "m1-32", "en": "Wonderful (praise)", "tr": "mashallah", "ar": "ما شاء الله"},
        {"id": "m1-33", "en": "Come on / let's go", "tr": "yallah", "ar": "يلا"},
        {"id": "m1-34", "en": "That's it / done / enough", "tr": "khalaas", "ar": "خلاص"},
        {"id": "m1-35", "en": "Sorry / never mind", "tr": "ma3laish", "ar": "معليش"},
        {"id": "m1-36", "en": "No problem / it's fine", "tr": "ma yikhaalif", "ar": "ما يخالف", "note": "A classic Gulf phrase."},
        {"id": "m1-37", "en": "Yes (casual)", "tr": "ee", "ar": "إي"},
        {"id": "m1-38", "en": "Yes (polite)", "tr": "na3am", "ar": "نعم"},
        {"id": "m1-39", "en": "No", "tr": "la", "ar": "لا"},
        {"id": "m1-40", "en": "God give you strength (to someone working)", "tr": "ya3teek al-3aafya", "ar": "يعطيك العافية"},
        {"id": "m1-41", "en": "God give you health (reply)", "tr": "allah y3aafeek", "ar": "الله يعافيك"},
        {"id": "m1-42", "en": "I didn't understand", "tr": "ma fhamt", "ar": "ما فهمت"},
        {"id": "m1-43", "en": "Say it again, please", "tr": "3eed law sama7t", "ar": "عيد لو سمحت"},
        {"id": "m1-44", "en": "Slowly, please", "tr": "shway shway law sama7t", "ar": "شوي شوي لو سمحت"},
        {"id": "m1-45", "en": "Do you speak English? (to a man)", "tr": "titkallam ingleezi?", "ar": "تتكلم إنجليزي؟"},
        {"id": "m1-46", "en": "I'm learning Arabic", "tr": "ana at3allam 3arabi", "ar": "أنا أتعلم عربي"}
      ]
    },
    {
      "id": "m2",
      "title": "Numbers, money and time",
      "blurb": "Count, ask prices, talk about times and days.",
      "items": [
        {"id": "m2-01", "en": "zero", "tr": "sifr", "ar": "صفر"},
        {"id": "m2-02", "en": "one", "tr": "waa7id", "ar": "واحد"},
        {"id": "m2-03", "en": "two", "tr": "ithnain", "ar": "اثنين"},
        {"id": "m2-04", "en": "three", "tr": "thalaath", "ar": "ثلاث"},
        {"id": "m2-05", "en": "four", "tr": "arba3", "ar": "أربع"},
        {"id": "m2-06", "en": "five", "tr": "khams", "ar": "خمس"},
        {"id": "m2-07", "en": "six", "tr": "sitt", "ar": "ست"},
        {"id": "m2-08", "en": "seven", "tr": "sab3", "ar": "سبع"},
        {"id": "m2-09", "en": "eight", "tr": "thamaan", "ar": "ثمان"},
        {"id": "m2-10", "en": "nine", "tr": "tis3", "ar": "تسع"},
        {"id": "m2-11", "en": "ten", "tr": "3ashar", "ar": "عشر"},
        {"id": "m2-12", "en": "eleven", "tr": "i7da3sh", "ar": "إحدعش"},
        {"id": "m2-13", "en": "twelve", "tr": "ithna3sh", "ar": "اثنعش"},
        {"id": "m2-14", "en": "fifteen", "tr": "khamsta3sh", "ar": "خمسطعش"},
        {"id": "m2-15", "en": "twenty", "tr": "3ishreen", "ar": "عشرين"},
        {"id": "m2-16", "en": "thirty", "tr": "thalaatheen", "ar": "ثلاثين"},
        {"id": "m2-17", "en": "fifty", "tr": "khamseen", "ar": "خمسين"},
        {"id": "m2-18", "en": "a hundred", "tr": "imya", "ar": "مية"},
        {"id": "m2-19", "en": "two hundred", "tr": "imyatain", "ar": "ميتين"},
        {"id": "m2-20", "en": "a thousand", "tr": "alf", "ar": "ألف"},
        {"id": "m2-21", "en": "dirham / dirhams", "tr": "dirham / daraahim", "ar": "درهم، دراهم"},
        {"id": "m2-22", "en": "How much is it?", "tr": "bkam?", "ar": "بكم؟", "note": "Emiratis often say bcham."},
        {"id": "m2-23", "en": "How much is this?", "tr": "bkam haadha?", "ar": "بكم هذا؟"},
        {"id": "m2-24", "en": "expensive", "tr": "ghaali", "ar": "غالي"},
        {"id": "m2-25", "en": "very / a lot", "tr": "wayid", "ar": "وايد"},
        {"id": "m2-26", "en": "Too expensive!", "tr": "ghaali wayid!", "ar": "غالي وايد!"},
        {"id": "m2-27", "en": "cheap", "tr": "rkhees", "ar": "رخيص"},
        {"id": "m2-28", "en": "Is there a discount?", "tr": "fi khasm?", "ar": "في خصم؟"},
        {"id": "m2-29", "en": "for you (lit. your share)", "tr": "7aggak", "ar": "حقك"},
        {"id": "m2-30", "en": "What time is it?", "tr": "kam is-saa3a?", "ar": "كم الساعة؟", "note": "Emiratis often say cham is-saa3a."},
        {"id": "m2-31", "en": "It's ten o'clock", "tr": "is-saa3a 3ashar", "ar": "الساعة عشر"},
        {"id": "m2-32", "en": "half (past)", "tr": "nuss", "ar": "نص"},
        {"id": "m2-33", "en": "quarter", "tr": "rub3", "ar": "ربع"},
        {"id": "m2-34", "en": "now", "tr": "al7een", "ar": "الحين"},
        {"id": "m2-35", "en": "today", "tr": "il-yoom", "ar": "اليوم"},
        {"id": "m2-36", "en": "tomorrow", "tr": "baachir", "ar": "باجر"},
        {"id": "m2-37", "en": "yesterday", "tr": "ams", "ar": "أمس"},
        {"id": "m2-38", "en": "later", "tr": "ba3dain", "ar": "بعدين"},
        {"id": "m2-39", "en": "in the morning", "tr": "is-sub7", "ar": "الصبح"},
        {"id": "m2-40", "en": "in the evening", "tr": "il-masa", "ar": "المسا"},
        {"id": "m2-41", "en": "One moment", "tr": "la7dha", "ar": "لحظة"},
        {"id": "m2-42", "en": "five minutes", "tr": "khams dagaayig", "ar": "خمس دقايق"},
        {"id": "m2-43", "en": "week", "tr": "usboo3", "ar": "أسبوع"},
        {"id": "m2-44", "en": "Friday", "tr": "il-jum3a", "ar": "الجمعة", "note": "Many Emiratis say il-yum3a."},
        {"id": "m2-45", "en": "Do you have time? (to a man)", "tr": "3indak wagt?", "ar": "عندك وقت؟"},
        {"id": "m2-46", "en": "OK, agreed", "tr": "zain, ittafagna", "ar": "زين، اتفقنا"}
      ]
    },
    {
      "id": "m3",
      "title": "Me, family and work",
      "blurb": "Introduce yourself, talk about where you're from, your work and your family.",
      "items": [
        {"id": "m3-01", "en": "What's your name? (to a man)", "tr": "shu ismak?", "ar": "شو اسمك؟"},
        {"id": "m3-02", "en": "What's your name? (to a woman)", "tr": "shu ismich?", "ar": "شو اسمچ؟"},
        {"id": "m3-03", "en": "My name is Pranjal", "tr": "ismi Pranjal", "ar": "اسمي برانجال"},
        {"id": "m3-04", "en": "Nice to meet you", "tr": "tsharrafna", "ar": "تشرفنا"},
        {"id": "m3-05", "en": "Where are you from? (to a man)", "tr": "inta min wain?", "ar": "إنت من وين؟"},
        {"id": "m3-06", "en": "I'm from India", "tr": "ana min il-hind", "ar": "أنا من الهند"},
        {"id": "m3-07", "en": "I live in Dubai", "tr": "askun fi dbai", "ar": "أسكن في دبي"},
        {"id": "m3-08", "en": "but / only", "tr": "bas", "ar": "بس"},
        {"id": "m3-09", "en": "I work in ...", "tr": "ashtaghil fi ...", "ar": "أشتغل في"},
        {"id": "m3-10", "en": "I have a company", "tr": "3indi sharika", "ar": "عندي شركة"},
        {"id": "m3-11", "en": "I'm an engineer", "tr": "ana muhandis", "ar": "أنا مهندس"},
        {"id": "m3-12", "en": "work", "tr": "shughul", "ar": "شغل"},
        {"id": "m3-13", "en": "office", "tr": "maktab", "ar": "مكتب"},
        {"id": "m3-14", "en": "meeting", "tr": "ijtimaa3", "ar": "اجتماع"},
        {"id": "m3-15", "en": "client", "tr": "3ameel", "ar": "عميل"},
        {"id": "m3-16", "en": "colleague", "tr": "zameel", "ar": "زميل"},
        {"id": "m3-17", "en": "friend", "tr": "rifeej", "ar": "رفيج", "note": "Gulf word; elsewhere sadeeg."},
        {"id": "m3-18", "en": "I have a meeting now", "tr": "3indi ijtimaa3 al7een", "ar": "عندي اجتماع الحين"},
        {"id": "m3-19", "en": "We have a meeting", "tr": "3indana ijtimaa3", "ar": "عندنا اجتماع"},
        {"id": "m3-20", "en": "I'm busy", "tr": "ana mashghool", "ar": "أنا مشغول"},
        {"id": "m3-21", "en": "I'm tired", "tr": "ana ta3baan", "ar": "أنا تعبان"},
        {"id": "m3-22", "en": "I'm happy", "tr": "ana mabsoot", "ar": "أنا مبسوط"},
        {"id": "m3-23", "en": "I'm hungry", "tr": "ana yoo3aan", "ar": "أنا يوعان", "note": "Emirati turns j into y: jooaan becomes yoo3aan."},
        {"id": "m3-24", "en": "family", "tr": "ahl", "ar": "أهل"},
        {"id": "m3-25", "en": "my father", "tr": "abooy", "ar": "أبوي"},
        {"id": "m3-26", "en": "my mother", "tr": "ummi", "ar": "أمي"},
        {"id": "m3-27", "en": "my brother", "tr": "akhooy", "ar": "أخوي"},
        {"id": "m3-28", "en": "my sister", "tr": "ukhti", "ar": "أختي"},
        {"id": "m3-29", "en": "children", "tr": "3yaal", "ar": "عيال"},
        {"id": "m3-30", "en": "Are you married? (to a man)", "tr": "inta mitzawwij?", "ar": "إنت متزوج؟"},
        {"id": "m3-31", "en": "Do you have children? (to a man)", "tr": "3indak 3yaal?", "ar": "عندك عيال؟"},
        {"id": "m3-32", "en": "man", "tr": "rayyaal", "ar": "ريال", "note": "Emirati for rajjaal."},
        {"id": "m3-33", "en": "house / home", "tr": "bait", "ar": "بيت"},
        {"id": "m3-34", "en": "apartment", "tr": "shagga", "ar": "شقة"},
        {"id": "m3-35", "en": "Who?", "tr": "minu?", "ar": "منو؟"},
        {"id": "m3-36", "en": "Why?", "tr": "laish?", "ar": "ليش؟"},
        {"id": "m3-37", "en": "When?", "tr": "mita?", "ar": "متى؟"},
        {"id": "m3-38", "en": "What?", "tr": "shu?", "ar": "شو؟"},
        {"id": "m3-39", "en": "I don't know", "tr": "ma adri", "ar": "ما أدري"},
        {"id": "m3-40", "en": "not (Gulf)", "tr": "mub", "ar": "مب", "note": "mub zain = not good."}
      ]
    },
    {
      "id": "m4",
      "title": "Getting around Dubai",
      "blurb": "Taxis, directions, the café and the shop.",
      "items": [
        {"id": "m4-01", "en": "Where?", "tr": "wain?", "ar": "وين؟"},
        {"id": "m4-02", "en": "Where are you going? (to a man)", "tr": "wain trou7?", "ar": "وين تروح؟"},
        {"id": "m4-03", "en": "Where's the metro?", "tr": "wain il-metro?", "ar": "وين المترو؟"},
        {"id": "m4-04", "en": "on the right", "tr": "3ala l-yimeen", "ar": "على اليمين"},
        {"id": "m4-05", "en": "on the left", "tr": "3ala l-yisaar", "ar": "على اليسار"},
        {"id": "m4-06", "en": "straight ahead", "tr": "seeda", "ar": "سيدة"},
        {"id": "m4-07", "en": "Turn right", "tr": "lif yimeen", "ar": "لف يمين"},
        {"id": "m4-08", "en": "Turn left", "tr": "lif yisaar", "ar": "لف يسار"},
        {"id": "m4-09", "en": "Stop here", "tr": "waggif hni", "ar": "وقف هني"},
        {"id": "m4-10", "en": "here", "tr": "hni", "ar": "هني"},
        {"id": "m4-11", "en": "there", "tr": "hnaak", "ar": "هناك"},
        {"id": "m4-12", "en": "near", "tr": "gareeb", "ar": "قريب"},
        {"id": "m4-13", "en": "far", "tr": "ba3eed", "ar": "بعيد"},
        {"id": "m4-14", "en": "at the traffic light", "tr": "3ind il-ishaara", "ar": "عند الإشارة"},
        {"id": "m4-15", "en": "roundabout", "tr": "dawwaar", "ar": "دوار"},
        {"id": "m4-16", "en": "traffic jam", "tr": "za7ma", "ar": "زحمة"},
        {"id": "m4-17", "en": "Is there traffic?", "tr": "fi za7ma?", "ar": "في زحمة؟"},
        {"id": "m4-18", "en": "I'm in a hurry", "tr": "ana mista3jil", "ar": "أنا مستعجل"},
        {"id": "m4-19", "en": "a little", "tr": "shway", "ar": "شوي"},
        {"id": "m4-20", "en": "car", "tr": "sayyaara", "ar": "سيارة"},
        {"id": "m4-21", "en": "What would you like? (to a man)", "tr": "shu tabi?", "ar": "شو تبي؟"},
        {"id": "m4-22", "en": "I want ...", "tr": "abi ...", "ar": "أبي"},
        {"id": "m4-23", "en": "coffee", "tr": "gahwa", "ar": "قهوة"},
        {"id": "m4-24", "en": "karak tea", "tr": "chaay karak", "ar": "چاي كرك"},
        {"id": "m4-25", "en": "water", "tr": "maay", "ar": "ماي"},
        {"id": "m4-26", "en": "without sugar", "tr": "bdoon sukkar", "ar": "بدون سكر"},
        {"id": "m4-27", "en": "or", "tr": "walla", "ar": "ولا"},
        {"id": "m4-28", "en": "also / too", "tr": "ba3ad", "ar": "بعد"},
        {"id": "m4-29", "en": "Do you have ...? (to a shop)", "tr": "3indkum ...?", "ar": "عندكم؟"},
        {"id": "m4-30", "en": "The bill, please", "tr": "il-faatoora law sama7t", "ar": "الفاتورة لو سمحت"},
        {"id": "m4-31", "en": "Give me ...", "tr": "3atni ...", "ar": "عطني"},
        {"id": "m4-32", "en": "I have cash", "tr": "3indi kaash", "ar": "عندي كاش"},
        {"id": "m4-33", "en": "There isn't any / there's none", "tr": "ma fi", "ar": "ما في"},
        {"id": "m4-34", "en": "No problem", "tr": "ma fi mushkila", "ar": "ما في مشكلة"},
        {"id": "m4-35", "en": "good / OK", "tr": "zain", "ar": "زين"},
        {"id": "m4-36", "en": "Let's go", "tr": "yallah nimshi", "ar": "يلا نمشي"},
        {"id": "m4-37", "en": "food", "tr": "akil", "ar": "أكل"},
        {"id": "m4-38", "en": "chicken", "tr": "diyaay", "ar": "دياي", "note": "Emirati for dijaaj."},
        {"id": "m4-39", "en": "delicious", "tr": "lazeedh", "ar": "لذيذ"},
        {"id": "m4-40", "en": "with me / I'm with you", "tr": "wiyyaay", "ar": "وياي"}
      ]
    },
    {"id": "m5", "title": "Food and restaurants", "blurb": "Ordering, preferences, invitations to eat.", "items": []},
    {"id": "m6", "title": "Shopping", "blurb": "Sizes, colours, bargaining, returns.", "items": []},
    {"id": "m7", "title": "Phone calls and plans", "blurb": "Calling, arranging, confirming and cancelling.", "items": []},
    {"id": "m8", "title": "Work and meetings", "blurb": "Projects, deadlines, agreeing and disagreeing.", "items": []},
    {"id": "m9", "title": "Home and building", "blurb": "Repairs, deliveries, the building guard and neighbours.", "items": []},
    {"id": "m10", "title": "Health and emergencies", "blurb": "Feeling unwell, the pharmacy, asking for help.", "items": []},
    {"id": "m11", "title": "Small talk and feelings", "blurb": "Weather, weekends, opinions and reactions.", "items": []},
    {"id": "m12", "title": "Telling stories", "blurb": "Past events, plans and connecting ideas.", "items": []}
  ],
  "dialogues": [
    {
      "id": "d1", "module": "m1", "title": "Morning at the office",
      "setting": "Your colleague Mariam greets you as you arrive.",
      "lines": [
        {"who": "Mariam", "voice": "f", "tr": "as-salaamu 3alaikum, sabaa7 al-khair!", "ar": "السلام عليكم، صباح الخير!", "en": "Peace be upon you, good morning!"},
        {"who": "You", "voice": "m", "tr": "wa 3alaikum as-salaam, sabaa7 an-noor.", "ar": "وعليكم السلام، صباح النور.", "en": "And upon you peace, good morning."},
        {"who": "Mariam", "voice": "f", "tr": "shlonak? shakhbaarak?", "ar": "شلونك؟ شخبارك؟", "en": "How are you? How are things?"},
